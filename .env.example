# ========================================
# THE REFORM ROOM — Environment Variables
# ========================================
# Kopiere diese Datei nach `.env.local` und trage die echten Werte ein.
# `.env.local` wird NICHT eingecheckt (siehe .gitignore).

# ----------------------------------------
# ANALYTICS & TRACKING
# ----------------------------------------
# Google Analytics 4 — Measurement ID (Format: G-XXXXXXXXXX)
# GA4 > Admin > Datenstreams > Web-Stream > Mess-ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ----------------------------------------
# BREVO (Kontaktformular + Newsletter)
# ----------------------------------------
# Eigene Reform-Room-Brevo-Instanz (nicht die Pulseclub-Instanz!)
# API-Key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Listen-ID für Newsletter-Kontakte: Brevo > Kontakte > Listen > ID der Liste
BREVO_LIST_ID=
# E-Mail-Adresse für Kontaktformular-Benachrichtigungen (Lisa)
BREVO_NOTIFY_EMAIL=Lisa.kutschinski@web.de
# Absender-Adresse für Brevo-Mails (muss in Brevo verifiziert sein)
BREVO_SENDER_EMAIL=info@thereformroom.de
# Template-ID Double-Opt-in Bestätigungsmail: Brevo > Transactional > Templates
BREVO_DOI_TEMPLATE_ID=
# Template-ID "Anfrage erhalten"-Bestätigung: Brevo > Transactional > Templates
BREVO_CONTACT_CONFIRM_TEMPLATE_ID=
# Optional: feste Listen-ID für Grand-Opening-Zusagen. Leer = Liste
# „Grand Opening Gästeliste“ wird beim ersten Eintrag automatisch angelegt.
BREVO_OPENING_LIST_ID=

# ----------------------------------------
# SITE
# ----------------------------------------
# Öffentliche Site-URL (für DOI-Redirect, Canonicals, Sitemap)
NEXT_PUBLIC_SITE_URL=https://thereformroom.de

# ----------------------------------------
# COMING SOON / PRE-LAUNCH
# ----------------------------------------
# Pre-Launch-Gate (Domain + Uhrzeit):
#   true  = thereformroom.de / www zeigen das Overlay, BIS zum Launch-Zeitpunkt
#   false = Gate sofort aus (volle Website)
# Netlify-Preview (*.netlify.app) und localhost sind IMMER ohne Gate.
NEXT_PUBLIC_PRELAUNCH_GATE=true

# Launch-Zeitpunkt (ISO mit Offset). Default im Code: 2026-09-12T20:00:30+02:00
# (Samstag 20:00:30 Europe/Berlin). Ab dann: Gate aus, Hero/Buchung live.
# Leer = Code-Default. Anderes Datum hier setzen.
NEXT_PUBLIC_LAUNCH_DATE=2026-09-12T20:00:30+02:00
